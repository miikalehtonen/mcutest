#!/bin/sh
set -eu

IMAGE="${MCUTEST_IMAGE:-mcutest:0.3.0}"
CACHE="${MCUTEST_HOST_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/mcutest}"
mkdir -p "$CACHE"

tty_args=""
if [ -t 0 ] && [ -t 1 ]; then
  tty_args="-t"
fi

exec docker run --rm -i $tty_args --init \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  -e WOKWI_CLI_TOKEN \
  -e ARDUINO_DIRECTORIES_DATA=/cache/arduino/data \
  -e ARDUINO_DIRECTORIES_DOWNLOADS=/cache/arduino/downloads \
  -e ARDUINO_DIRECTORIES_USER=/cache/arduino/user \
  -e ARDUINO_BUILD_CACHE_PATH=/cache/arduino/build-cache \
  -e ARDUINO_BUILD_CACHE_TTL="${MCUTEST_BUILD_CACHE_TTL:-168h}" \
  -e ARDUINO_BUILD_CACHE_COMPILATIONS_BEFORE_PURGE=10 \
  -e PLATFORMIO_CORE_DIR=/cache/platformio \
  -e MCUTEST_CACHE=/cache/workspaces \
  -e MCUTEST_JOBS="${MCUTEST_JOBS:-8}" \
  -e MCUTEST_WORKSPACE_TTL_DAYS="${MCUTEST_WORKSPACE_TTL_DAYS:-30}" \
  -e MCUTEST_WOKWI_RETRIES="${MCUTEST_WOKWI_RETRIES:-2}" \
  -e "MCUTEST_PROJECT_KEY=$PWD" \
  -v "$PWD:/workspace" \
  -v "$CACHE:/cache" \
  -w /workspace \
  "$IMAGE" "$@"
